#!ipxe
# The image this fixture boots is built by os-image/ and served by nico-vms'
# own file server, so the lane pulls nothing from a CDN.
#
# nico-vms never fetches boot-loader: it parses image_url out of this script
# (internal/ipxe/parser.go) and does the GRUB work qcow-imager.efi would do on
# bare metal (internal/ipxe/bootcmd.go). The variable stays because a real
# bare-metal boot needs it; point it at your own published EFI there.
#
# The gateway address, not carbide-pxe.forge: nico-vms downloads the image on
# the host, and the host resolves that name only through dnsmasq on the bridge.
set boot-loader unused-by-nico-vms
set image-url http://172.30.0.1:18080/files/images/nke-node.qcow2
set disk-strategy {{ .DiskSelectionStrategy }}

# You probably don't need to change these
set console-config console=tty0 console=ttyS1,115200
set kernel-params pci=realloc=off reboot=pci loglevel=1 iommu=pt intel_iommu=on
set luks-key luks.key=changeit
set cloud-init-ds ds=nocloud-net;s=${cloudinit-url}

chain ${boot-loader} ${console-config} ${kernel-params} ${luks-key} image_url=${image-url} disk_strategy=${disk-strategy} ${cloud-init-ds} update_grub_template=yes update_grub_cfg=yes
boot
