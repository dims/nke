[Unit]
Description=SPIRE Agent
Documentation=https://github.com/spiffe/spire
After=network.target

[Service]
Type=simple
EnvironmentFile=-/etc/spire-agent/spire-agent.env
ExecStart=/usr/local/bin/spire-agent run -config /etc/spire-agent/agent.conf -expandEnv
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spire-agent
User=spire
Group=spire
SupplementaryGroups=tss

[Install]
WantedBy=multi-user.target
